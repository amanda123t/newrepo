// Schema para desenvolvimento local — usa SQLite
// Arrays são armazenados como JSON strings (SQLite não suporta arrays nativos)
// O middleware em lib/db.ts faz a conversão automaticamente

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANTS / ORGANIZATIONS
// ============================================================
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  users     User[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("CONSULTANT")
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientsResponsible     Client[]          @relation("ClientResponsible")
  processesResponsible   Process[]         @relation("ProcessConsultant")
  opportunitiesOwned     Opportunity[]     @relation("OpportunityOwner")
  analysesAuthored       ProcessAnalysis[]
}

// ============================================================
// CLIENTS
// ============================================================
model Client {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  segment        String
  size           String
  responsibleId  String?
  responsible    User?     @relation("ClientResponsible", fields: [responsibleId], references: [id])
  projectStatus  String    @default("ACTIVE")
  startDate      DateTime?
  endDate        DateTime?
  teamMembers    String    @default("[]") // JSON array
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  processes      Process[]
}

// ============================================================
// PROCESSES
// ============================================================
model Process {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultantId         String?
  consultant           User?     @relation("ProcessConsultant", fields: [consultantId], references: [id])

  name                 String
  area                 String
  macroprocess         String?
  type                 String
  description          String?
  objective            String?

  bpmnFileUrl          String?
  bpmnFileName         String?
  version              String    @default("1.0")
  mappingDate          DateTime?

  monthlyVolume        Int?
  avgExecutionTime     Float?
  peopleInvolved       Int?
  systemsUsed          String    @default("[]") // JSON array
  standardizationLevel Int?      @default(0)
  automationLevel      Int?      @default(0)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  analysis             ProcessAnalysis?
  opportunities        Opportunity[]
  indicators           ProcessIndicator[]
  versions             ProcessVersion[]
}

// ============================================================
// PROCESS ANALYSIS
// ============================================================
model ProcessAnalysis {
  id              String    @id @default(cuid())
  processId       String    @unique
  process         Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id])

  complexity      String
  maturity        String
  problems        String    @default("[]") // JSON array of ProcessProblem values
  analyticalNotes String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// OPPORTUNITIES
// ============================================================
model Opportunity {
  id                       String    @id @default(cuid())
  processId                String
  process                  Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  ownerId                  String?
  owner                    User?     @relation("OpportunityOwner", fields: [ownerId], references: [id])

  description              String
  type                     String
  expectedImpact           String
  implementationComplexity String
  effortEstimate           String?
  estimatedHoursReduction  Float?
  estimatedCostReduction   Float?
  operationalRiskReduction String?

  status                   String    @default("IDENTIFIED")
  deadline                 DateTime?
  progress                 Int?      @default(0)
  observations             String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// ============================================================
// PROCESS INDICATORS
// ============================================================
model ProcessIndicator {
  id           String                 @id @default(cuid())
  processId    String
  process      Process                @relation(fields: [processId], references: [id], onDelete: Cascade)

  name         String
  type         String
  unit         String?
  target       Float?
  current      Float?

  measurements IndicatorMeasurement[]

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model IndicatorMeasurement {
  id          String           @id @default(cuid())
  indicatorId String
  indicator   ProcessIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  value       Float
  measuredAt  DateTime
  notes       String?
  createdAt   DateTime         @default(now())
}

// ============================================================
// PROCESS VERSIONS
// ============================================================
model ProcessVersion {
  id          String   @id @default(cuid())
  processId   String
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  version     String
  changes     String?
  bpmnFileUrl String?
  createdAt   DateTime @default(now())
}
